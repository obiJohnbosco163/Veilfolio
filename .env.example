# Veilfolio frontend environment (all optional — public defaults are hardcoded).
# Copy to `app/.env.local` only if you need to override a default.

# Default JSON-RPC for Sepolia (used by starknet-react provider + lib/strk20.ts).
NEXT_PUBLIC_STARKNET_RPC_URL=https://starknet-sepolia-rpc.publicnode.com

# On-chain contract addresses (defaults are hardcoded in app/lib/contracts.ts).
NEXT_PUBLIC_IDENTITY_MANAGER_ADDRESS=0x05e9b7866bb7a77a8c9881e46847963eae20b5d7222c99c5f9f0985560d4d1fb
NEXT_PUBLIC_ANONYMIZER_ADDRESS=0x0066bb5b454d5a8488cd3988afd9a6790e38dc6f9e51e7ba162237a903c44ab3

# ── Deployment scripts (NOT used by the frontend) ───────────────────────────
# The scripts read these env vars. Never put a private key in the repo.
# STARKNET_RPC=https://starknet.drpc.org
# STARKNET_DEPLOYER_ADDRESS=0x...
# STARKNET_DEPLOYER_KEY=0x...       # deployer private key — generate fresh, keep secret