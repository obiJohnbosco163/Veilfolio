# Starknet Network Configuration
NEXT_PUBLIC_STARKNET_NETWORK=mainnet
NEXT_PUBLIC_RPC_URL=https://starknet-mainnet.g.alchemy.com/starknet/version/rpc/v0_7
NEXT_PUBLIC_STRK20_POOL_ADDRESS=

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STARKNET_EXPLORER=https://starkscan.co

# Privacy Configuration (To be populated after API inspection)
NEXT_PUBLIC_PRIVACY_WALLET_API_VERSION=

# Optional: Backend API (if used)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Demo Mode (set to true to run in demo mode)
NEXT_PUBLIC_DEMO_MODE=false
